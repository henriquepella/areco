# Copie para .env (que NÃO é versionado):  cp .env.example .env   |  Windows: copy .env.example .env

# ---- Provedor de IA -------------------------------------------------------------
# none      -> sem modelo: respostas extrativas/determinísticas a partir das bases (padrão)
# anthropic -> Claude (SDK oficial). Exige LLM_API_KEY. Modelo padrão: claude-opus-5-5
# openai    -> qualquer API compatível com /chat/completions (OpenAI, Ollama, OpenRouter...)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# Opcional. Ex.: Ollama no host a partir do container: http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# ---- Aplicação ------------------------------------------------------------------
APP_PORT=8000
MAX_QUESTION_CHARS=1000
RETRIEVAL_TOP_K=4
LOG_LEVEL=INFO
# KNOWLEDGE_DIR e FRONTEND_DIR já são definidos na imagem; ajuste só fora do Docker se necessário.
